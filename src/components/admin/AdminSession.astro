---
interface Props {
    apiUrl: string;
    loginUrl?: string;
}

const { apiUrl, loginUrl = "/admin/login/" } = Astro.props;
---

<div
    id="auth-loading"
    class="fixed inset-0 z-50 flex items-center justify-center bg-neutral-100"
>
    <div class="rounded-lg border border-neutral-200 bg-white px-6 py-4">
        <p id="auth-loading-text" class="text-sm text-neutral-500">
            Checking session...
        </p>
    </div>
</div>

<script
    define:vars={{
        apiUrl,
        loginUrl,
    }}
>
    async function initializeAdminSession() {
        const loading = document.getElementById("auth-loading");

        const loadingText = document.getElementById("auth-loading-text");

        try {
            const response = await fetch(`${apiUrl}/auth/session`, {
                credentials: "include",
                headers: {
                    Accept: "application/json",
                },
            });

            if (!response.ok) {
                window.location.replace(loginUrl);
                return;
            }

            loading?.remove();
        } catch (error) {
            console.error("Session check failed:", error);

            if (loadingText) {
                loadingText.textContent = "Unable to verify session.";
            }
        }
    }

    document
        .getElementById("logout-button")
        ?.addEventListener("click", async () => {
            try {
                await fetch(`${apiUrl}/auth/logout`, {
                    method: "POST",
                    credentials: "include",
                });
            } finally {
                window.location.replace(loginUrl);
            }
        });

    initializeAdminSession();
</script>
