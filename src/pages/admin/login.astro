---
import "../../styles/admin.css";

const base = import.meta.env.BASE_URL;
const panelUrl = `${base}admin/`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex, nofollow" />
        <title>Admin login</title>
    </head>

    <body class="admin-body">
        <main class="admin-login-page">
            <section class="admin-login-box" aria-labelledby="login-title">
                <h1 id="login-title">Admin login</h1>
                <p>Sign in to manage your campaign website.</p>

                <form id="admin-login-form" class="admin-form">
                    <div class="admin-field">
                        <label for="email">Email</label>
                        <input
                            class="admin-input"
                            id="email"
                            name="email"
                            type="email"
                            autocomplete="username"
                            required
                        />
                    </div>

                    <div class="admin-field">
                        <label for="password">Password</label>
                        <input
                            class="admin-input"
                            id="password"
                            name="password"
                            type="password"
                            autocomplete="current-password"
                            required
                        />
                    </div>

                    <button class="admin-button" type="submit">Sign in</button>

                    <p
                        id="login-status"
                        class="admin-status"
                        aria-live="polite"
                    >
                    </p>
                </form>

                <noscript>
                    <p class="admin-note">
                        JavaScript is required to connect this form to an
                        authentication provider.
                    </p>
                </noscript>
            </section>
        </main>

        <script is:inline>
            const form = document.getElementById("admin-login-form");
            const status = document.getElementById("login-status");

            if (!(form instanceof HTMLFormElement)) {
                console.error("Login form not found.");
            } else if (!(status instanceof HTMLElement)) {
                console.error("Login status not found.");
            } else {
                form.addEventListener("submit", async (event) => {
                    // Stops the browser from submitting and changing the URL.
                    event.preventDefault();

                    const formData = new FormData(form);
                    const email = String(formData.get("email") ?? "").trim();
                    const password = String(formData.get("password") ?? "");

                    if (!email || !password) {
                        status.textContent = "Enter your email and password.";
                        return;
                    }

                    status.textContent = "Checking your login…";

                    try {
                        const response = await fetch(
                            "https://api.andrewforcouncil.com/auth/login",
                            {
                                method: "POST",
                                credentials: "include",
                                headers: {
                                    "Content-Type": "application/json",
                                    Accept: "application/json",
                                },
                                body: JSON.stringify({
                                    email,
                                    password,
                                }),
                            },
                        );

                        const result = await response.json().catch(() => null);

                        if (!response.ok) {
                            status.textContent =
                                result?.message ??
                                "The email or password is incorrect.";
                            return;
                        }

                        status.textContent = "Login successful.";

                        const base =
                            document.documentElement.dataset.base ?? "/";
                        window.location.replace(`${base}admin/`);
                    } catch (error) {
                        console.error("Login request failed:", error);
                        status.textContent =
                            "Unable to contact the login server.";
                    }
                });
            }
        </script>
    </body>
</html>
