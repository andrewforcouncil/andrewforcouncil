---
import "../../styles/admin.css";

interface Props {
    title?: string;
    pageTitle?: string;
}

const { title = "Admin", pageTitle = "Dashboard" } = Astro.props;

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const adminHome = `${base}admin/`;
const loginPage = `${base}admin/login/`;

const navItems = [
    {
        label: "Dashboard",
        href: adminHome,
    },

    // Add additional admin pages here:
    // {
    //   label: "Content",
    //   href: `${base}admin/content/`,
    // },
    // {
    //   label: "Users",
    //   href: `${base}admin/users/`,
    // },
];

function isCurrent(href: string): boolean {
    const normalizedCurrent = currentPath.endsWith("/")
        ? currentPath
        : `${currentPath}/`;

    const normalizedHref = href.endsWith("/") ? href : `${href}/`;

    return normalizedCurrent === normalizedHref;
}
---

<!doctype html>
<html lang="en" data-auth-pending>
    <head>
        <meta charset="UTF-8" />

        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <meta name="robots" content="noindex, nofollow" />

        <title>{title}</title>
    </head>

    <body class="admin-body">
        <!--
      This is displayed while require-admin.ts checks the user's session.
      The actual admin panel remains hidden until authentication succeeds.
    -->
        <div class="admin-auth-loading" role="status" aria-live="polite">
            Checking session…
        </div>

        <div class="admin-shell">
            <aside class="admin-sidebar">
                <a class="admin-brand" href={adminHome}> Site Admin </a>

                <nav class="admin-nav" aria-label="Admin navigation">
                    {
                        navItems.map((item) => (
                            <a
                                href={item.href}
                                aria-current={
                                    isCurrent(item.href) ? "page" : undefined
                                }
                            >
                                {item.label}
                            </a>
                        ))
                    }
                </nav>

                <div class="admin-sidebar-footer">
                    <a href={base}> View public site </a>
                </div>
            </aside>

            <main class="admin-main">
                <header class="admin-header">
                    <h1>{pageTitle}</h1>

                    <!--
            Replace this link with a call to your backend logout endpoint
            when logout functionality is implemented.
          -->
                    <a
                        class="admin-button admin-button--secondary"
                        href={loginPage}
                    >
                        Sign out
                    </a>
                </header>

                <div class="admin-content">
                    <slot />
                </div>
            </main>
        </div>

        <!--
      This script must remove data-auth-pending from the <html> element
      after the backend confirms that the user is an administrator.
    -->
        <script>
            import "../../scripts/admin";
        </script>
    </body>
</html>

<style>
    .admin-auth-loading {
        min-height: 100vh;
        display: none;
        place-items: center;
        padding: 24px;
        color: var(--admin-muted);
        text-align: center;
    }

    /*
   * Hide the admin interface while authentication is being checked.
   */
    html[data-auth-pending] .admin-auth-loading {
        display: grid;
    }

    html[data-auth-pending] .admin-shell {
        display: none;
    }
</style>
